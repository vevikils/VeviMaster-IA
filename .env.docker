# Archivo de variables de entorno para Docker
# Copia este archivo a .env y configura los valores

# Genera una nueva SECRET_KEY en: https://djecrety.ir/
SECRET_KEY=your-secret-key-here

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

# URL de base de datos (opcional, por defecto usa SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
